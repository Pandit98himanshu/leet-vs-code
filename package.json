{
  "name": "minimal-leetcode-md",
  "displayName": "Minimal LeetCode.md",
  "version": "1.7.5",
  "main": "./dist/extension.js",
  "author": "pandit98himanshu",
  "publisher": "leetcode-md",
  "icon": "media/leetcode.png",
  "license": "MIT",
  "engines": {
    "vscode": "^1.107.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Pandit98himanshu/leetcode.md.git"
  },
  "homepage": "https://github.com/Pandit98himanshu/leetcode.md#readme",
  "bugs": {
    "url": "https://github.com/Pandit98himanshu/leetcode.md/issues"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "coding",
    "dsa",
    "practicing",
    "faang"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onView:leetcode-mdProblems",
    "onView:leetcode-mdSubmissions",
    "onCommand:leetcode-md.showDailyChallenge",
    "onCommand:leetcode-md.searchProblem",
    "onCommand:leetcode-md.viewAllProblems",
    "onCommand:leetcode-md.showUserProfile",
    "onCommand:leetcode-md.openSolution",
    "onCommand:leetcode-md.submitSolution",
    "onCommand:leetcode-md.setSession",
    "onCommand:leetcode-md.clearSession",
    "onCommand:leetcode-md.showMySubmissions"
  ],
  "description": "Browse LeetCode problems, view daily challenges, and look up user profiles directly in VS Code.",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "leetcode-md",
          "title": "LeetCode",
          "icon": "media/leetcode.svg"
        }
      ],
      "panel": [
        {
          "id": "leetcode-mdPanel",
          "title": "LeetCode Results",
          "icon": "$(beaker)"
        }
      ]
    },
    "views": {
      "leetcode-md": [
        {
          "id": "leetcode-mdProblems",
          "name": "All Problems",
          "icon": "$(list-unordered)"
        },
        {
          "id": "leetcode-mdDailyQuestions",
          "name": "Daily Questions",
          "icon": "$(calendar)"
        },
        {
          "id": "leetcode-mdSubmissions",
          "name": "My Submissions",
          "icon": "$(history)"
        }
      ],
      "leetcode-mdPanel": [
        {
          "id": "leetcode-mdTestResultsView",
          "name": "Test Results",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "leetcode-md.refreshDailyQuestions",
        "title": "Refresh Daily Questions",
        "icon": "$(refresh)"
      },
      {
        "command": "leetcode-md.showDailyChallenge",
        "title": "Show Daily Challenge",
        "icon": "$(flame)"
      },
      {
        "command": "leetcode-md.searchProblem",
        "title": "Search Problem",
        "icon": "$(search)"
      },
      {
        "command": "leetcode-md.viewAllProblems",
        "title": "View All Problems"
      },
      {
        "command": "leetcode-md.showUserProfile",
        "title": "Show User Profile",
        "icon": "$(account)"
      },
      {
        "command": "leetcode-md.openSolution",
        "title": "Open Solution File",
        "icon": "$(file-code)"
      },
      {
        "command": "leetcode-md.submitSolution",
        "title": "Submit Solution",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "leetcode-md.testSolution",
        "title": "Test Solution",
        "icon": "$(play)"
      },
      {
        "command": "leetcode-md.setSession",
        "title": "Set Session Cookie",
        "icon": "$(key)"
      },
      {
        "command": "leetcode-md.clearSession",
        "title": "Clear Session Cookie",
        "icon": "$(sign-out)"
      },
      {
        "command": "leetcode-md.showMySubmissions",
        "title": "Show my recent Submissions",
        "icon": "$(history)"
      },
      {
        "command": "leetcode-md.clearTestResults",
        "title": "Clear Test Results",
        "icon": "$(clear-all)"
      },
      {
        "command": "leetcode-md.prevMonthDaily",
        "title": "Previous Month",
        "icon": "$(arrow-left)",
        "enablement": "leetcode-md:hasPrevMonth"
      },
      {
        "command": "leetcode-md.nextMonthDaily",
        "title": "Next Month",
        "icon": "$(arrow-right)",
        "enablement": "leetcode-md:hasNextMonth"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "leetcode-md.searchProblem",
          "when": "view == leetcode-mdProblems",
          "group": "navigation@2"
        },
        {
          "command": "leetcode-md.showUserProfile",
          "when": "view == leetcode-mdProblems",
          "group": "navigation@3"
        },
        {
          "command": "leetcode-md.setSession",
          "when": "view == leetcode-mdProblems && !leetcode-md:hasSession",
          "group": "navigation@4"
        },
        {
          "command": "leetcode-md.clearSession",
          "when": "view == leetcode-mdProblems && leetcode-md:hasSession",
          "group": "navigation@4"
        },
        {
          "command": "leetcode-md.refreshDailyQuestions",
          "when": "view == leetcode-mdDailyQuestions",
          "group": "navigation@0"
        },
        {
          "command": "leetcode-md.prevMonthDaily",
          "when": "view == leetcode-mdDailyQuestions",
          "group": "navigation@1"
        },
        {
          "command": "leetcode-md.nextMonthDaily",
          "when": "view == leetcode-mdDailyQuestions",
          "group": "navigation@2"
        },
        {
          "command": "leetcode-md.showDailyChallenge",
          "when": "view == leetcode-mdDailyQuestions",
          "group": "navigation@3"
        },
        {
          "command": "leetcode-md.showMySubmissions",
          "when": "view == leetcode-mdSubmissions && leetcode-md:hasSession",
          "group": "navigation@0"
        },
        {
          "command": "leetcode-md.clearTestResults",
          "when": "view == leetcode-mdTestResultsView",
          "group": "navigation@0"
        }
      ]
    },
    "configuration": {
      "title": "Leet-VS-Code",
      "properties": {
        "leetcode-md.defaultDifficulty": {
          "type": "string",
          "default": "All",
          "enum": [
            "All",
            "Easy",
            "Medium",
            "Hard"
          ],
          "description": "Default difficulty filter for prolem browsing"
        },
        "leetcode-md.rootDir": {
          "type": "string",
          "default": "",
          "description": "Root directory for all LeetVSCode storage (solutions, cache, etc.). Leave empty to use the default (~/.leetcode-md)."
        },
        "leetcode-md.defaultLanguage": {
          "type": "string",
          "default": "",
          "enum": [
            "",
            "cpp",
            "java",
            "python3",
            "python",
            "c",
            "csharp",
            "javascript",
            "typescript",
            "php",
            "swift",
            "kotlin",
            "dart",
            "golang",
            "ruby",
            "scala",
            "rust",
            "racket",
            "erlang",
            "elixir"
          ],
          "enumDescriptions": [
            "No default",
            "C++",
            "Java",
            "Python 3",
            "Python",
            "C",
            "C#",
            "JavaScript",
            "TypeScript",
            "PHP",
            "Swift",
            "Kotlin",
            "Dart",
            "Go",
            "Ruby",
            "Scala",
            "Rust",
            "Racket",
            "Erlang",
            "Elixir"
          ],
          "description": "Default language for code snippets. The snippet panel will open in this language if available."
        }
      }
    }
  },
  "scripts": {
    "build": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --platform=node --format=cjs --minify",
    "watch": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --platform=node --format=cjs --watch",
    "package": "vsce package --no-dependencies"
  },
  "dependencies": {
    "leetcode-query": "^2.0.1",
    "turndown": "^7.2.4"
  },
  "devDependencies": {
    "@types/node": "^25.9.3",
    "@types/turndown": "^5.0.6",
    "@types/vscode": "^1.107.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.28.1",
    "typescript": "^6.0.3"
  }
}